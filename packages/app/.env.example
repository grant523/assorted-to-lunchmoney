LUNCH_MONEY_API_KEY=...

MONEY_FORWARD_EMAIL_ADDRESS=...
MONEY_FORWARD_AUTH_PASSWORD=...
MONEY_FORWARD_OTPAUTH_URI=...

# Optional background execution settings
# NON_INTERACTIVE=true   # Default: false in interactive TTY, true in non-TTY/cron
# HEADLESS=true          # Default: true (set to false to show Chromium window)
# SCRAPE=true            # Default: true in non-interactive, prompts in interactive
# REMATCH=false          # Default: false (set to true to wipe and rematch accounts)